{
  "name": "prompt-bench",
  "version": "0.1.0",
  "description": "A CLI eval/regression-testing harness for prompt engineering - define a suite of test cases in YAML, run them against the real Claude API, and get a pass/fail report with diffs for failures.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "prompt-bench": "./bin/prompt-bench.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/prompt-bench.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
